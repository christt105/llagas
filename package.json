{
  "name": "llagas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted tracker for mouth ulcers with Immich photos",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "import:obsidian": "node --disable-warning=ExperimentalWarning server/import-obsidian.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "preact": "^11.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
